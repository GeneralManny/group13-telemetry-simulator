# Variables for the n8n service (Railway service "n8n"). Placeholders only; never commit real values.
# The workflows read the last group through $env, so no secret is stored in the workflow JSON.

# n8n itself
N8N_HOST=n8n.example.invalid
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_LISTEN_ADDRESS=::
N8N_PROXY_HOPS=1
WEBHOOK_URL=https://n8n.example.invalid/
N8N_ENCRYPTION_KEY=replace-with-secret
GENERIC_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# The Code nodes read the variables below, so environment access must stay enabled.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Database: n8n keeps its own schema in the same Postgres as the monitor.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db.example.invalid
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=railway
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=replace-with-secret
DB_POSTGRESDB_SCHEMA=n8n

# Execution history: keep failures, skip the many successful ingestion runs, prune after 7 days.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Read by the workflows
# Must equal N8N_WEBHOOK_TOKEN on the simulator service.
SIMULATOR_WEBHOOK_TOKEN=replace-with-secret
# The monitor's internal address and the same MONITOR_INGEST_KEY as the simulator service.
MONITOR_API_URL=http://simulator.internal:3000
MONITOR_INGEST_KEY=replace-with-secret-at-least-16-chars
# Dashboard address used in alert links.
DASHBOARD_URL=https://simulator.example.invalid
# Slack app: incoming webhook URL and signing secret (Basic Information, App Credentials).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/secret
SLACK_SIGNING_SECRET=replace-with-secret
# true adds the Approve, Escalate and Dismiss buttons to alerts.
SLACK_INTERACTIVE=true
