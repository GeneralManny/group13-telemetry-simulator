# Copy to .env for local development. Never commit the real .env.
# In production, set these in the Railway service's Variables tab.

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Required in production (unless a webhook is added in the dashboard).
# Placeholder values below are treated as "missing" by /ready.
N8N_WEBHOOK_URL=https://example.invalid/webhook/telemetry
N8N_WEBHOOK_TOKEN=replace-with-secret
CONTROL_API_KEY=replace-with-secret

# Optional: lets teams add their own n8n webhooks in the dashboard without run control.
TEAM_ACCESS_KEY=replace-with-secret

# Where dashboard webhooks are saved. Mount a Railway volume here so they survive restarts.
DATA_DIR=./data
# MAX_WEBHOOKS=20

DEFAULT_EVENT_RATE=2
DEFAULT_MATCH_DURATION_SECONDS=300
DELIVERY_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=4
MAX_QUEUE_SIZE=1000

# Optional tuning
# DELIVERY_CONCURRENCY=4
# RETRY_DELAYS_MS=1000,3000,10000

# Comma-separated list of dashboard origins allowed to call the API from a browser
ALLOWED_ORIGIN=https://dashboard.example.invalid
