# Copy to .env for local development. Never commit the real .env.
# In production, set these in the Railway service's Variables tab.

PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Listen address (default 0.0.0.0). "::" listens on IPv4 and IPv6, which Railway private networking needs.
HOST=::

# Public address of this service. Used for the "Open case" link in Slack alerts.
PUBLIC_BASE_URL=https://simulator.example.invalid

# Monitor: Postgres connection and the key n8n uses to store events and record reviews.
# Without DATABASE_URL the simulator runs on its own and the monitor is not started.
DATABASE_URL=postgres://user:replace-with-secret@db.example.invalid:5432/railway
MONITOR_INGEST_KEY=replace-with-secret-at-least-16-chars

# Required in production (unless a webhook is added in the dashboard).
# Placeholder values below are treated as "missing" by /ready.
N8N_WEBHOOK_URL=https://example.invalid/webhook/telemetry
N8N_WEBHOOK_TOKEN=replace-with-secret
CONTROL_API_KEY=replace-with-secret

# Optional: lets teams add their own n8n webhooks in the dashboard without run control.
TEAM_ACCESS_KEY=replace-with-secret

# Where dashboard webhooks are saved. Mount a Railway volume here so they survive restarts.
DATA_DIR=./data
# MAX_WEBHOOKS=20

DEFAULT_EVENT_RATE=2
DEFAULT_MATCH_DURATION_SECONDS=300
DELIVERY_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=4
MAX_QUEUE_SIZE=1000

# Optional tuning
# DELIVERY_CONCURRENCY=4
# RETRY_DELAYS_MS=1000,3000,10000

# Comma-separated list of dashboard origins allowed to call the API from a browser
ALLOWED_ORIGIN=https://dashboard.example.invalid

# Optional: AI case summaries through OpenRouter free models. Without a key, the template is used.
# OPENROUTER_API_KEY=replace-with-secret
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openrouter/free
